# --- AWS / DynamoDB (mesma base usada pela web e pelo mobile) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Sessao da API REST consumida pelo aplicativo mobile ---
# String aleatoria com no minimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Origem permitida no CORS da API. Use "*" em desenvolvimento.
API_ALLOWED_ORIGIN=*

# --- Notificacoes push (Expo) ---
# Opcional. Necessario apenas se o projeto Expo exigir autenticacao no envio.
EXPO_ACCESS_TOKEN=

# --- E-mail (relatorios) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL publica da aplicacao (usada pelo envio de relatorios)
NEXT_PUBLIC_APP_URL=http://localhost:3000
