{
  "name": "toliso",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo To Liso — plataforma web (Next.js) e aplicativo mobile (Expo/React Native) compartilhando a mesma base de dados.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w @toliso/web",
    "web:build": "npm run build -w @toliso/web",
    "web:start": "npm run start -w @toliso/web",
    "mobile": "npm run start -w @toliso/mobile",
    "mobile:android": "npm run android -w @toliso/mobile",
    "mobile:apk": "npm run build:apk -w @toliso/mobile",
    "mobile:prebuild": "npm run prebuild -w @toliso/mobile",
    "typecheck": "npm run typecheck -w @toliso/core && npm run typecheck -w @toliso/web && npm run typecheck -w @toliso/mobile",
    "build": "npm run web:build"
  },
  "engines": {
    "node": ">=18 <23"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "@xmldom/xmldom": "^0.8.15",
    "uuid": "^11.1.1"
  }
}
