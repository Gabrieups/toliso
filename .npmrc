# O Metro (React Native) nao lida bem com arvores de dependencia aninhadas.
# O npm ja instala tudo achatado na raiz do workspace, que e o que o Expo espera.
legacy-peer-deps=true

# React fica fixado na raiz na versao exata exigida pelo React Native, para que
# a web e o aplicativo usem a mesma copia e react/react-dom nunca divirjam.
